{{!
    @template local_activityfilter/template_name

    A automatic resizeable input text field with a submit button.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}

<form id="ai_activity_filter_prompt_form">
    <div class="card prompt-card">
        <div class="card-body">
            <textarea class="prompt-search w-100" id="activitysearchprompt"
                      placeholder="{{#str}}promptdesc, local_activityfilter{{/str}}" rows="1"></textarea>
        </div>
        <button class="btn btn-primary prompt-search-btn" type="button" data-action="activityfilter-search">
            <span class="label">{{#pix}}a/search, core, {{#str}}search, local_activityfilter{{/str}}{{/pix}}</span>
            <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
        </button>
    </div>
</form>
